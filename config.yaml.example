# 한국투자증권 Open API 설정 (모의투자)
# 1) https://apiportal.koreainvestment.com 에서 모의투자용 앱을 등록하고
#    APP KEY / APP SECRET 을 발급받으세요.
# 2) 모의투자 계좌번호(8자리-2자리)는 KIS 영업점/HTS에서 개설한 모의계좌 번호입니다.
# 3) 이 파일을 config.yaml 로 복사한 뒤 값을 채우세요. (config.yaml 은 git 에 올라가지 않음)

# 모의투자: true / 실전투자: false  (지금은 반드시 true 로 시작)
paper_trading: true

app_key: "여기에_APP_KEY"
app_secret: "여기에_APP_SECRET"

# 계좌번호 종합(앞 8자리)
account_no: "50000000"
# 계좌 상품코드(뒤 2자리). 주식: 01
account_product_code: "01"

# 자동매매 설정
trading:
  # [sma_cross 전용] 감시 종목 (국내 6자리 종목코드)
  domestic_symbols: ["005930", "000660"]   # 삼성전자, SK하이닉스

  poll_interval_sec: 10      # [sma_cross] 시세 확인 주기(초)
  order_qty: 1               # [sma_cross] 1회 주문 수량
  max_position_per_symbol: 5 # [sma_cross] 종목당 최대 보유 수량

  # [screener_rotation 전용] 리밸런싱·주문 파라미터
  risk_check_interval_sec: 60      # 손절/트레일링 감시 주기(초). 리밸런스는 1일 1회 자동
  invest_ratio: 0.95               # 가용 현금 중 투자 비율(나머지 버퍼)
  max_position_value_krw: 0        # 종목당 최대 매수금액(원). 0=무제한(동일비중)
  quote_market: "UN"               # 시세 시장: UN(통합 KRX+NXT, 권장) | J(KRX) | NX(NXT)
                                   #   UN이면 NXT 연장시간(프리 08~09 / 애프터 15:30~20:00)
                                   #   변동까지 손절 감시에 반영됨
  order_type: "limit"              # limit(지정가, 권장) | market(시장가, 밀림 위험)
  limit_band_bps: 30               # 매수 지정가 상한(현재가 +0.30%까지만 체결)
  exit_band_bps: 50                # 매도 지정가(현재가 -0.50%, 체결 우선)

# 전략 선택: sma_cross(기본) | screener_rotation
strategy:
  name: "sma_cross"          # 단순이동평균 교차 전략(기존)
  short_window: 5
  long_window: 20

  # name 을 아래로 바꾸면 '검증된' 로테이션으로 동작:
  # name: "screener_rotation"
  # top_n: 10                # 보유 종목 수(동일비중). 검증: 10이 5보다 낙폭 적음
  # regime_filter: true      # 지수가 N일선 아래면 현금 보유(하락장 방어)
  # regime_ma: 200           # 시장국면 판정 이동평균(일)
  # score_method: "blend"    # 종목 점수: screener(4팩터) | ml(LightGBM) | blend
  #   ⚠️ 워크포워드 맞대결(python -m src.strategy_compare) 결과 v1 권장 = blend top10
  #      (샤프 0.85·MDD -23%). screener 단독은 OOS 최악(샤프 0.22)이라 비권장.
  #      ml/blend 쓰려면 먼저 모델 학습: python -m src.ml_serve --train
  #
  # --- 리스크 청산(2층) — 0이면 비활성 ---
  # ⚠️ 검증 결과(python -m src.tune_exits): 낙폭의 진짜 통제 수단은 손절이 아니라
  #    위의 regime_filter 다. (국면필터만으로 MDD -70%→-42%). 손절은 보조 안전핀.
  #    타이트한 손절(-8% 등)은 '휩쏘'로 수익을 깎으니 금지. 켤 거면 넓게(15~25%).
  #    트레일링은 이 추세전략에선 전 구간 샤프 악화 → 기본 비활성 권장.
  # stop_loss_pct: 20        # 꼬리위험 컷용 넓은 손절(권장 15~25, 0=끔)
  # trailing_pct: 0          # 트레일링스톱(이 전략엔 비권장)
  # take_profit_pct: 0       # +N% 익절(0=사용 안 함)
  #
  # 청산 파라미터 튜닝(공정 A/B):
  #   python -m src.tune_exits --regime-filter   # 손절/트레일링 그리드 비교
  #
  # 실행 단계(안전 순서):
  #   python -m src.run_bot --plan       # 타깃만 확인 (API/주문 없음)
  #   python -m src.run_bot --once --dry-run  # 잔고 반영하되 주문 안 함
  #   python -m src.run_bot --once       # 모의계좌에 실제(모의) 주문 1회
  #   python -m src.run_bot              # 선정 1일1회 + 손절 분단위 감시
  #
  # 백테스트로 손절 효과 검증:
  #   python -m src.backtest --top-n 5 --stop-loss-pct 8   (vs 손절 없이 비교)

# ===========================================================================
# 장중 단타 트랙 (국내 급등주 봇) — python -m src.surge_bot
# ---------------------------------------------------------------------------
# ⚠️ 위 run_bot(일봉 추세 로테이션)과 완전히 별개인 실험 트랙이다.
#    일봉 백테스트로 검증 불가(분봉 과거데이터 없음) → 모의계좌로 직접 돌리며
#    surge_trade 학습데이터를 쌓는 게 검증 방법이다. 반드시 모의(paper)에서만.
#
# 안전 순서:
#   python -m src.surge_bot --dry-run   # 주문 없이 스캔·신호만(장중 권장 첫 점검)
#   python -m src.surge_bot --once      # 모의계좌에 실제(모의) 주문 1주기
#   python -m src.surge_bot             # 주기 반복(장중 내내)
surge:
  # --- 스캔 풀 ---
  market: "0000"          # 스캔 시장: 0000전체 / 0001코스피 / 1001코스닥
  scan_source: "both"     # 후보 출처: rate(등락률상위) / value(거래대금상위·유동성) / both
  scan_top: 40            # 등락률 상위 몇 종목 받을지
  value_top: 40           # 거래대금 상위 몇 종목 받을지(유동성 단타 유니버스)
  exclude_etf: true       # 지수 ETF/ETN 제외(개별주만 단타)
  exclude_leverage_inverse: true  # 레버리지·인버스 제외(추세가정·decay 부적합)

  # --- 진입 필터 ---
  min_rate: 3.0           # 진입 최소 등락률(%)
  max_rate: 25.0          # 상한(강세장 급등주도 포함; 너무 낮으면 후보 고갈)
  min_volume: 100000      # 최소 누적거래량(유동성)
  price_min: 2000         # 동전주 배제(원)
  price_max: 100000       # 고가주 배제(원)

  # --- 종목 선정 기준 (매수세 우위 + 유동성) ---
  min_imbalance: 0.0      # 호가 매수세 우위(임밸런스>=0) 선호. 호가 미수집은 거래대금순 매수
  rank_by: "imbalance"    # 정렬: imbalance(매수세) | value(거래대금) | rate(등락률) | rvol(상대거래량)
  # 상대거래량(RVOL) = 당일누적거래량 / (20일평균거래량 × 장경과비율). 해외 검증
  # (Zarattini·Barbon·Aziz 2024, 미국 7천종목 2016~23): '평소보다 거래가 몰린'
  # 종목(RVOL≥1 상위, Stocks in Play)으로 제한할 때만 단타 수익이 유의미.
  # 0=필터 끔(피처 기록만). rvol 데이터가 쌓여 국내에서도 확인되면 1.0 권장.
  min_rvol: 0.0
  # VWAP 위에서만 매수(해외 ORB 봇 표준 룰: 현재가>당일VWAP = 평균 체결가가 지지).
  # vwap_dev(현재가/VWAP-1)는 항상 피처로 기록됨(스캔 응답으로 산출, 추가호출 없음).
  # 기본 OFF — 데이터가 쌓여 국내에서도 효과가 확인되면 true 권장.
  require_above_vwap: false
  reentry_cooldown_min: 10 # 판 종목 재매수 금지(분) — 같은 종목 churn 방지
  ob_capture_top: 10      # 호가 잔량 임밸런스 수집(=매수 후보 풀) 상위 N (호출제한↔거래활성)

  # --- 하락 반등 데이터 수집 (수집 전용, 매수 안 함) ---
  scan_rebound: true      # 하락률 상위도 스캔해 양방향 데이터 수집
  rebound_top: 40
  rebound_ob_top: 4       # 반등 후보 호가 수집 상위 N

  # --- 포지션·청산 ---
  max_positions: 6        # 동시 보유 종목 수(많을수록 주기당 호출↑)
  order_value_krw: 0      # 종목당 배정금액(원). 0이면 order_qty 사용
  order_qty: 1            # order_value_krw=0 일 때 주문 수량
  take_profit_pct: 2.0    # 익절(+%)
  stop_loss_pct: -1.0     # 손절(−%, 음수로)
  trailing_pct: -1.5      # 트레일링스톱(고점 대비 −%, 음수로)
  max_hold_min: 30        # 보유 N분 초과 시 강제 청산(리밸런싱). 0=비활성
  buy_band_bps: 30        # 매수 지정가 상한(현재가 대비 bps)
  sell_band_bps: 50       # 매도 지정가(체결우선 위해 넓게)
  entry_order_type: "limit"  # limit(지정가) / market(시장가) / best(최유리지정가)
  quote_market: "UN"      # 시세: UN통합(KRX+NXT) / J KRX / NX
  poll_interval_sec: 45   # 폴링 주기(초). 모의 호출제한 고려(45초 권장)

  # --- 지수 국면 필터(방어) ---
  regime_filter: true     # 지수 급락 중이면 신규 매수 중단(청산·수집은 계속)
  # 시장 국면 프록시 지수(쉼표로 복수). 게이트는 '최악값' — 하나만 급락해도 매수 중단.
  # 스캔이 전체시장(코스닥 다수)이라 코스피200만 보면 코스닥 단독 급락(10년간 268일,
  # 연평균 27일, 평균 -2.26%)을 놓침 → KODEX200 + KODEX코스닥150 기본 권장.
  # 첫 번째 지수는 학습 피처(index_chg)로도 기록됨(과거 데이터와 연속성).
  regime_index: "069500,229200"
  regime_min_chg: -1.5    # 지수 등락률 이 % 미만이면 매수 OFF

  # --- 학습 모델(선택) — data/surge_model.pkl 있을 때만 작동 ---
  # 단타 데이터를 쌓아 학습: python -m src.surge_ml --train
  use_model: true         # 모델로 후보 점수화/재정렬(없으면 위 규칙)
  min_pred_ret: -1.0      # 예측수익 이 값 미만 후보 제외(-1=제외안함)
