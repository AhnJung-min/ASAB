# 한국투자증권 Open API 설정 (모의투자)
# 1) https://apiportal.koreainvestment.com 에서 모의투자용 앱을 등록하고
#    APP KEY / APP SECRET 을 발급받으세요.
# 2) 모의투자 계좌번호(8자리-2자리)는 KIS 영업점/HTS에서 개설한 모의계좌 번호입니다.
# 3) 이 파일을 config.yaml 로 복사한 뒤 값을 채우세요. (config.yaml 은 git 에 올라가지 않음)

# 모의투자: true / 실전투자: false  (지금은 반드시 true 로 시작)
paper_trading: true

app_key: "여기에_APP_KEY"
app_secret: "여기에_APP_SECRET"

# 계좌번호 종합(앞 8자리)
account_no: "50000000"
# 계좌 상품코드(뒤 2자리). 주식: 01
account_product_code: "01"

# 자동매매 설정
trading:
  # [sma_cross 전용] 감시 종목 (국내: 6자리 종목코드 / 해외: 거래소+심볼)
  domestic_symbols: ["005930", "000660"]   # 삼성전자, SK하이닉스
  overseas_symbols:                          # 미국 주식 예시
    - { exchange: "NAS", symbol: "AAPL" }
    - { exchange: "NAS", symbol: "TSLA" }

  poll_interval_sec: 10      # [sma_cross] 시세 확인 주기(초)
  order_qty: 1               # [sma_cross] 1회 주문 수량
  max_position_per_symbol: 5 # [sma_cross] 종목당 최대 보유 수량

  # [screener_rotation 전용] 리밸런싱·주문 파라미터
  risk_check_interval_sec: 60      # 손절/트레일링 감시 주기(초). 리밸런스는 1일 1회 자동
  invest_ratio: 0.95               # 가용 현금 중 투자 비율(나머지 버퍼)
  max_position_value_krw: 0        # 종목당 최대 매수금액(원). 0=무제한(동일비중)
  order_type: "limit"              # limit(지정가, 권장) | market(시장가, 밀림 위험)
  limit_band_bps: 30               # 매수 지정가 상한(현재가 +0.30%까지만 체결)
  exit_band_bps: 50                # 매도 지정가(현재가 -0.50%, 체결 우선)

# 전략 선택: sma_cross(기본) | screener_rotation
strategy:
  name: "sma_cross"          # 단순이동평균 교차 전략(기존)
  short_window: 5
  long_window: 20

  # name 을 아래로 바꾸면 '검증된' 스크리너+시장국면 로테이션으로 동작:
  # name: "screener_rotation"
  # top_n: 5                 # 보유 종목 수(동일비중)
  # regime_filter: true      # 지수가 N일선 아래면 현금 보유(하락장 방어)
  # regime_ma: 200           # 시장국면 판정 이동평균(일)
  #
  # --- 리스크 청산(2층) — 0이면 비활성 ---
  # stop_loss_pct: 8         # 매입가 대비 -8% 손절
  # trailing_pct: 5          # 보유 중 고점 대비 -5% 트레일링스톱
  # take_profit_pct: 0       # +N% 익절(0=사용 안 함, 추세추종은 보통 트레일링만)
  #
  # 실행 단계(안전 순서):
  #   python -m src.run_bot --plan       # 타깃만 확인 (API/주문 없음)
  #   python -m src.run_bot --once --dry-run  # 잔고 반영하되 주문 안 함
  #   python -m src.run_bot --once       # 모의계좌에 실제(모의) 주문 1회
  #   python -m src.run_bot              # 선정 1일1회 + 손절 분단위 감시
  #
  # 백테스트로 손절 효과 검증:
  #   python -m src.backtest --top-n 5 --stop-loss-pct 8   (vs 손절 없이 비교)
